{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  /* Só .ts/.tsx — o resto do site é .jsx sem tipos (mesma escolha dos outros
     projetos deste repo que usam TS: Assets/Footer e Assets/Logo). Sem
     allowJs, os .jsx ficam fora deste programa TS e continuam checados pelo
     modo solto de JS puro que já usavam, sem herdar o strict daqui. */
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
